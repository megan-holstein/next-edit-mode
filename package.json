{
  "name": "next-edit-mode",
  "version": "1.1.0",
  "description": "Development-only inline copy editing for Next.js dev servers and Electron apps: click a sentence on the page, type over it, and the source file that produced it is rewritten.",
  "keywords": [
    "nextjs",
    "electron",
    "wysiwyg",
    "inline-editing",
    "copy-editing",
    "developer-tools",
    "typescript",
    "ast",
    "app-router"
  ],
  "license": "MIT",
  "author": "Holstein Creations LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megan-holstein/next-edit-mode.git"
  },
  "homepage": "https://github.com/megan-holstein/next-edit-mode#readme",
  "bugs": "https://github.com/megan-holstein/next-edit-mode/issues",
  "type": "module",
  "bin": {
    "next-edit-mode": "./install.mjs"
  },
  "exports": {
    "./overlay": "./src/overlay.tsx",
    "./engine": "./src/engine.ts",
    "./routes": "./src/routes.ts",
    "./install": "./install.mjs"
  },
  "files": [
    "src",
    "install.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "next": "^15",
    "react": "^19",
    "typescript": "^5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "node test/build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  }
}
